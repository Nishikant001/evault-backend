# ─────────────────────────────────────────────────────────────────
# PRODUCTION
# ─────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001


# ─────────────────────────────────────────────────────────────────
# SAP / DMS
# ─────────────────────────────────────────────────────────────────

# SAP_BASE_URL=http://192.168.12.3:8000/sap/opu/odata/sap/Z_DMS_SRV_TEST_SRV/
# SAP_USERNAME=SAPDMS
# SAP_PASSWORD="TeamGolyan@2580"


# ─────────────────────────────────────────────────────────────────
# DEFAULT / LEGACY DB
# ─────────────────────────────────────────────────────────────────

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sap_dms
DB_USER=root
DB_PASSWORD="Nishi@2000"


# ─────────────────────────────────────────────────────────────────
# PHASE A — MASTER DATABASE
# ─────────────────────────────────────────────────────────────────

MASTER_DB_HOST=localhost
MASTER_DB_PORT=3306
MASTER_DB_NAME=procur_master
MASTER_DB_USER=root
MASTER_DB_PASSWORD="Nishi@2000"


# ─────────────────────────────────────────────────────────────────
# PHASE C — TENANT DATABASE
# ─────────────────────────────────────────────────────────────────

TENANT_DB_HOST=localhost
TENANT_DB_PORT=3306
TENANT_DB_NAME=procur_tenant
TENANT_DB_USER=root
TENANT_DB_PASSWORD="Nishi@2000"

TENANT_DB_POOL_MAX=5
TENANT_DB_POOL_MIN=0
TENANT_DB_POOL_ACQUIRE=30000
TENANT_DB_POOL_IDLE=10000


# ─────────────────────────────────────────────────────────────────
# PHASE D — TENANT DATABASE NAMING
# ─────────────────────────────────────────────────────────────────

TENANT_DB_PREFIX=tenant


# ─────────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# ─────────────────────────────────────────────────────────────────

JWT_SECRET='nnnnnnnnnnnnnnnnnnnnnnnnnnnn' 
JWT_REFRESH_SECRET=RefreshTokenSecret123


# ─────────────────────────────────────────────────────────────────
# SUPER ADMIN
# ─────────────────────────────────────────────────────────────────

SUPER_ADMIN_EMAIL=admin@test.com
SUPER_ADMIN_PASSWORD="Admin@123"


# ─────────────────────────────────────────────────────────────────
# AI DOCUMENT ASSISTANT (RAG)
# ─────────────────────────────────────────────────────────────────

# Optional — configure only if using environment-based AI fallback
# AI_DEFAULT_PROVIDER=OPENAI
# AI_DEFAULT_CHAT_MODEL=gpt-4o-mini
# AI_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
# AI_DEFAULT_BASE_URL=
# AI_ENCRYPTION_KEY="CHANGE_ME_IN_PRODUCTION"

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-06-01


# ─────────────────────────────────────────────────────────────────
# OPTIONAL EXTERNAL VECTOR STORES
# Default vector store is MYSQL
# ─────────────────────────────────────────────────────────────────

# PGVECTOR_HOST=
# PGVECTOR_PORT=5432
# PGVECTOR_DB=
# PGVECTOR_USER=
# PGVECTOR_PASSWORD=

# PINECONE_API_KEY=
# PINECONE_INDEX_HOST=

# QDRANT_URL=
# QDRANT_API_KEY=


# ─────────────────────────────────────────────────────────────────
# PHASE H — WILDCARD TENANT SUBDOMAIN ROUTING
# ─────────────────────────────────────────────────────────────────

# Example:
# BASE_DOMAIN=app.mydms.com

# BASE_DOMAIN=


# ─────────────────────────────────────────────────────────────────
# REVERSE PROXY
# Nginx → Node.js
# ─────────────────────────────────────────────────────────────────

TRUST_PROXY_HOPS=1


# ─────────────────────────────────────────────────────────────────
# EXTRA CORS ORIGINS
# ─────────────────────────────────────────────────────────────────

# Example:
# EXTRA_ALLOWED_ORIGINS=https://mydms.com,https://admin.mydms.com

# EXTRA_ALLOWED_ORIGINS=


# ─────────────────────────────────────────────────────────────────
# INTERNAL COMMUNICATION — CHAT / VOICE / CALL
# ─────────────────────────────────────────────────────────────────

# Socket.IO allowed origins
# Set this to your actual frontend domain when frontend is deployed.

# COMMUNICATION_SOCKET_ORIGIN=https://your-frontend-domain.com


# Voice messages
# CHAT_VOICE_MAX_DURATION_SECONDS=120
# CHAT_VOICE_MAX_SIZE_BYTES=10485760
# CHAT_VOICE_STORAGE_PATH=uploads/communication/voice
# CHAT_VOICE_ALLOWED_MIME_TYPES=audio/webm,audio/ogg,audio/mp4,audio/mpeg,audio/wav


# File attachments
# CHAT_ATTACHMENT_MAX_SIZE_BYTES=26214400
# CHAT_ATTACHMENT_MAX_FILES_PER_MESSAGE=10
# CHAT_ATTACHMENT_STORAGE_PATH=uploads/communication/attachments
# CHAT_ATTACHMENT_ALLOWED_MIME_TYPES=


# Calling
# COMMUNICATION_CALL_RING_TIMEOUT_MS=30000


# Redis — only required when running multiple Node.js instances
# REDIS_URL=
# Encrypt ERP outbound credentials stored in Master DB. Use a long random secret.
ERP_CREDENTIAL_ENCRYPTION_KEY="CHANGE_ME_IN_PRODUCTION"
