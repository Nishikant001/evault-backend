# Copy to .env and fill in. NEVER commit real values.
NODE_ENV=production
PORT=3000
MASTER_DB_HOST=
MASTER_DB_PORT=3306
MASTER_DB_NAME=
MASTER_DB_USER=
MASTER_DB_PASSWORD=
TENANT_DB_HOST=
TENANT_DB_PORT=3306
TENANT_DB_USER=
TENANT_DB_PASSWORD=
TENANT_DB_PREFIX=
JWT_SECRET=
JWT_REFRESH_SECRET=
ERP_CREDENTIAL_ENCRYPTION_KEY=

# ── OCR (new) ────────────────────────────────────────────────
# REQUIRED to save licensed-provider credentials. >= 32 random chars, e.g. `openssl rand -base64 48`.
# Keep in a secret manager / process env. Not derived from JWT_SECRET; no dev fallback.
# Losing or rotating it makes stored provider credentials undecryptable (tenants must re-enter them).
OCR_CREDENTIAL_ENCRYPTION_KEY=

# Tesseract (all optional; defaults shown)
OCR_LANGUAGES=eng
# Directory containing <lang>.traineddata (uncompressed). Defaults to backend/ if eng.traineddata is there.
OCR_LANG_PATH=
OCR_PDF_DPI=300
OCR_PAGE_TIMEOUT_MS=120000
OCR_MAX_PAGES=50
OCR_MAX_CONCURRENT_JOBS=2
OCR_GOOD_CONFIDENCE=85
OCR_MAX_PREPROCESS_VARIANTS=3
OCR_NATIVE_MIN_CHARS=40
OCR_NATIVE_MIN_WORDS=8

# Licensed provider limits (Google Document AI online processing)
OCR_PROVIDER_MAX_PAGES=15
OCR_PROVIDER_MAX_BYTES=20971520
OCR_PROVIDER_TIMEOUT_MS=90000
